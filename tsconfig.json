{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitepress/client"]
  },
  "include": ["packages/theme/**/*", "sites/*/.vitepress/**/*"],
  "exclude": ["**/node_modules", "**/.vitepress/cache", "**/.vitepress/dist"]
}
